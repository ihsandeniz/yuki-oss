# ============================================================
# Yuki Companion · Ortam Ayarları
# Kurulum:  cp .env.example .env   → sonra kendi değerlerini gir
# ============================================================

# ── LLM API Anahtarı (BYOK — kendi anahtarını getir) ─────────
# Alice'in çalışması için bir LLM API anahtarı GEREKLİ.
# Companion sohbeti çok ucuzdur (ayda birkaç $) — genelde $20'lık
# bir sohbet aboneliğinden daha az tutar.
#
# ⚠️ ChatGPT Plus / Gemini Advanced / Claude Pro ABONELİKLERİ burada
#    KULLANILAMAZ — onlar API değildir. Aşağıdaki API anahtarlarından
#    birine ihtiyacın var (abonelikten ayrıdır).
#
# 🎯 ÜCRETSİZ BAŞLA (kredi kartı gerekmez):
#    1) https://openrouter.ai/keys → Google/GitHub ile giriş → "Create Key"
#    2) Anahtarı aşağıya OPENROUTER_API_KEY olarak yapıştır
#    3) LLM_MODEL'i ":free" ekli ücretsiz bir modele ayarla, örn:
#         LLM_MODEL=google/gemma-4-26b-a4b-it:free
#    → Tek anahtarla onlarca modele erişirsin; ":free" ekli olanlar ücretsizdir.
#
# 💳 ÜCRETSİZ KOTA — sınır var, arıza değil (doğrulandı: 2026-08-05):
#    • dakikada 20 istek
#    • günde 50 istek  (hesabında hiç kredi yoksa)
#    • bir kez 10$ kredi alırsan günlük sınır 1.000 olur
#    Kota dolunca 429 gelir ve BEKLEMEKLE GEÇMEZ — ertesi gün sıfırlanır.
#    Yeni hesap/anahtar açmak sınırı değiştirmez; kota hesap bazlı değil geneldir.
#
# ⚠️ Ücretsiz modeller sağlayıcı tarafından KALDIRILABİLİR (bu satırdaki eski öneri
#    2026-08-01'de kalktı ve ürün "404 No endpoints found" verdi). Buradaki ID'yi
#    ezberleme — ⚙ AYAR → 🔑 ANAHTAR panelindeki liste OpenRouter'dan canlı gelir,
#    doğru olan odur.
#
OPENROUTER_API_KEY=

# Aktif sağlayıcı ve model
# LLM_PROVIDER: openrouter (varsayılan, önerilen) | google | openai | anthropic |
#               groq | cerebras | deepseek | mistral | xai | together |
#               fireworks | deepinfra | nebius | chutes
#   ⚠️ Bu listeden yalnız `openrouter` gerçek anahtarla uçtan uca DENENDİ.
#      Diğerleri OpenAI-uyumlu protokol konuştukları için destekleniyor; arayüzde
#      "denenmedi" etiketiyle gösterilirler. Sorun çıkarsa openrouter'a dön.
LLM_PROVIDER=openrouter
# Varsayılan model. Ücretsiz başlamak için ":free" ekli bir model seç.
# ⚠️ Model ID'si sağlayıcıya özgüdür: OpenRouter'da "google/gemma-…:free",
#    Google'da "gemini-3.5-flash-lite", OpenAI'da "gpt-4.1-mini". Sağlayıcı
#    değiştirirken modeli de değiştir (panel bunu otomatik yapar).
LLM_MODEL=google/gemma-4-26b-a4b-it:free

# ── Diğer sağlayıcı anahtarları (opsiyonel) ──────────────────
# Hepsi aynı anda dolu olabilir; LLM_PROVIDER hangisinin kullanılacağını seçer.
# ⚙ AYAR → 🔑 ANAHTAR panelinden girilen anahtarlar da buraya yazılır.
# ⚠️ Yorumu anahtarın SAĞINA yazma: python-dotenv satır-sonu yorumunu DEĞER sanıyor
#    (ölçüldü, 2026-08-05) → boş sanılan değişken aslında "# https://…" dolu gelir,
#    ürün "anahtar ayarlı" der ve çöp anahtarla isteğe çıkar. Yorum ÜSTTE durur.

# https://aistudio.google.com/apikey  (AIza… · ücretsiz kademe var)
GOOGLE_API_KEY=
# https://platform.openai.com/api-keys  (sk-… · ücretsiz kademe yok)
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys  (sk-ant-…)
ANTHROPIC_API_KEY=
# https://console.groq.com/keys  (gsk_… · ücretsiz kademe var)
GROQ_API_KEY=
# https://cloud.cerebras.ai/  (csk-… · ücretsiz kademe var)
CEREBRAS_API_KEY=
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# https://console.x.ai/  (xai-…)
XAI_API_KEY=
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# https://fireworks.ai/account/api-keys  (fw_…)
FIREWORKS_API_KEY=
# https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=
# https://studio.nebius.com/settings/api-keys
NEBIUS_API_KEY=
# https://chutes.ai/app/api  (cpk_…)
CHUTES_API_KEY=

# ── Sunucu Portu ─────────────────────────────────────────────
# 🔴 BUNU BOŞ BIRAKMA. config.py varsayılanı 8001 (2026-11-16'ya kadar 8000'di) ve 8000 bu geliştirme
#    makinesinde KİŞİSEL Alice'in portudur — şablonu kopyalayıp PORT yazmayan
#    bir kurulum ürünü doğrudan onun portuna oturtur (start.sh 8000 verilirse
#    durur, ama backend elle başlatılırsa kapı yok).
#    Eklendi 2026-09-11 /doc-sync: kodda okunan 146 değişkenden 130'u bu
#    şablonda yoktu ve PORT onlardan biriydi.
PORT=8001

# ── Erişim Parolası ──────────────────────────────────────────
# Uygulamaya giriş parolası. BOŞ = yalnız localhost'ta parolasız açılır.
# Başka cihazdan / tünelden erişim varsa MUTLAKA güçlü bir değer gir.
AUTH_TOKEN=

# ── Yüz Tanıma / Uygulama Kilidi (opsiyonel) ─────────────────
# 2026-09-06 turunda bu dört anahtar şablona "yazılamadı" (izin kapısı);
# 2026-09-11 /doc-sync'te eklendi. Hepsi config.py varsayılanlarıyla aynı.
# 🔴 FACE_RECOGNITION_THRESHOLD=0.45, det_size=640'a KALİBRE — det_size'ı
#    küçültürsen bu eşik sessizce geçersizleşir (yanlış kişiyi kabul riski).
# FACE_AUTH_ENABLED=true
# FACE_POSE_CORRECTION=auto     # 1k3d68 (137 MB) yüklensin mi · auto = RAM eşiğinin altındaysa yükleme
# FACE_LOW_MEMORY_GB=8          # auto'nun eşiği
# FACE_ORT_THREADS=0            # 0 = min(4, çekirdek)
# FACE_IDLE_UNLOAD_MIN=10       # kaç dk boştan sonra model bellekten düşsün (0=kapalı)

# ── Zamanlayıcı ──────────────────────────────────────────────
# Hatırlatıcılar, sabah brifingi, gece bakımı ve fitnes "günü" bu saat dilimine göre çalışır.
# Boş = bilgisayarın kendi saat dilimi (bulunamazsa yerel UTC farkı; ad yoksa UTC).
# Sunucu/kap UTC'de ama sen başka bir saat dilimindeysen burada IANA adını ver.
# SCHEDULER_TIMEZONE=Europe/Berlin

# ── Hafıza ───────────────────────────────────────────────────
# MEMORY_BACKEND: hafıza motoru
#   sqlite   = varsayılan. Gömülü (sqlite-vec) — kurulum yok, tek dosya,
#              veriler senin bilgisayarında kalır. "Unutmayan Yuki" (Ultra) bunu kullanır.
#   pgvector = kendi PostgreSQL+pgvector sunucun (self-host/sunucu kurulumu için)
MEMORY_BACKEND=sqlite
# Hafıza dosyasının yeri (boş = uygulama veri klasörü). Örn: /home/ben/yuki-memory.db
# MEMORY_DB_PATH=
#
# Yalnız MEMORY_BACKEND=pgvector için — kendi veritabanın.
# Port, kök docker-compose.yml'deki YUKI_PG_PORT ile AYNI olmalı (varsayılan 5437).
# ⚠️ 5433 YAZMA: bu depo geliştirme makinesinde kişisel Alice'in yanında duruyor
#    ve 5433 onun pgvector portu (compose `network_mode: host` kullanıyor →
#    port yalıtımı yok, çakışma değil DEVRALMA olur). Bekçi:
#    backend/tests/test_pg_portu_izole.py
# DATABASE_URL=postgresql://yuki:yuki_secret@localhost:5437/alice_ai
# YUKI_POSTGRES_PASSWORD=yuki_secret

# ── Dil ──────────────────────────────────────────────────────
# Başlangıç dili. TEK EKSEN: hem Yuki'nin konuştuğu dili hem arayüzü sürer.
#   tr = Türkçe (varsayılan) · ja = 日本語 · en = English
# Uygulama içinden de değiştirilebilir (⚙ AYAR → Asistan Dili, ya da
# "speak English" / "Japonca konuş" demen yeter) ve seçim KALICIDIR —
# `config.user.json`'a yazılır, buradaki değeri ezer.
# Kayıt: backend/app/config.py::LANGUAGES
# ASSISTANT_LANGUAGE=tr

# ── Ses ──────────────────────────────────────────────────────
# Varsayılan Edge TTS bedavadır ve kurulum gerektirmez — genelde
# buraya bir şey girmen gerekmez. Ses KİMLİĞİ dilden gelir (yukarıdaki
# ASSISTANT_LANGUAGE), üslup personadan. Gelişmiş (opsiyonel) bulut sesi:
# USE_ELEVENLABS_TTS=false
# ELEVENLABS_API_KEY=

# ── Yüz Tanıma — düşük donanım ayarları (opsiyonel) ──────────
# Yüzle giriş açıkken yüz modelleri belleğe yüklenir. Aşağıdaki dört ayar
# az RAM'li / az çekirdekli makinelerde bu yükü düşürür.
# Ölçüm (12 çekirdek / 31 GB): varsayılan 358 MB & 32 iş parçacığı;
# eski davranış 560 MB & 78 iş parçacığıydı.
# ⚠️ Bellek kazancı YALNIZ düşük RAM'li makinede çıkar — güçlü makinede
#    kazanç sadece iş parçacığı sayısındadır.
#
# FACE_POSE_CORRECTION: aşırı kafa açısını düzelten model (1k3d68, 137 MB)
#   yüklensin mi.  auto (varsayılan) = RAM eşiğin altındaysa yükleme
#   1/true = her zaman yükle · 0/false = hiç yükleme
#   Kapalıyken canlılık ve tanıma ÇALIŞMAYA DEVAM EDER; kaybedilen tek şey
#   aşırı açılı kafa pozunda yapılan düzeltmedir.
# FACE_POSE_CORRECTION=auto
#
# FACE_POSE_CORRECTION=auto için RAM eşiği (GB). Toplam RAM bunun altındaysa
# poz düzeltme modeli yüklenmez.
# FACE_LOW_MEMORY_GB=8
#
# ONNX iş parçacığı havuzunun tavanı. 0 = otomatik (min(4, çekirdek sayısı)).
# Arka planda başka ağır iş koşuyorsa 1-2'ye çekilebilir.
# FACE_ORT_THREADS=0
#
# Kaç dakika boşta kaldıktan sonra yüz modelleri bellekten düşsün. 0 = kapalı
# (modeller açık kaldığı sürece bellekte durur; ilk tanıma daha hızlı olur).
# FACE_IDLE_UNLOAD_MIN=10

# ── Bayraklı özellikler ─────────────────────────────────────
# Kapalıyken uçları 404 döner, araçları asistana sunulmaz, arayüz gizler.
# Atölye (arka plan görevleri) varsayılan AÇIK; kapatmak için false yaz ve backend'i yeniden başlat.
# Yalnız buradan değişir (ayarlar ekranında yok).
# ATOLYE=true
#
# Fitnes (PLAN › FİTNES) varsayılan KAPALI. HQ › Sistem › "Fitnes" anahtarıyla açılır
# (yeniden başlatma gerekmez) ya da burada true yazılır. Veri yalnız bu bilgisayarda.
# FITNES=false
#
# Atölye öneri motoru: Plan listesi / yarım iş / tekrar eden işten "yapayım mı?" önerisi.
# Motor görev başlatamaz; öneri Atölye'de ONAYLA ile başlar. Tur 30 dakikada bir koşar.
# Günde en çok kaç yeni öneri:
# YUKI_ATOLYE_ONERI_GUNLUK=3
# Öneri bildirimi (Web Push + "Yuki dedi"); 0 kapatır:
# YUKI_ATOLYE_ONERI_BILDIRIM=1
# İki öneri bildirimi arasında en az kaç dakika:
# YUKI_ATOLYE_ONERI_BILDIRIM_DK=120
# Öneri kaynakları (virgülle): plan, yarim, rutin
# YUKI_ATOLYE_ONERI_KAYNAKLAR=plan,yarim,rutin
# Plan'da önerilerin okunduğu listenin adı:
# YUKI_ATOLYE_ONERI_PLAN_LISTE=Yuki
# Bildirim gönderilmeyen saat aralığı (SS-SS, gece yarısını aşabilir):
# YUKI_ATOLYE_SESSIZ=23-08
# Görev bitince/yarım kalınca bildirim; 0 kapatır (bildirim içerik taşımaz):
# YUKI_ATOLYE_BITIS_BILDIRIM=1

# ── Kamera görüşü ve ses kimliği (biyometrik, varsayılan kapalı) ──
# Açılsa da ayrıca HQ › Sistem'de, yalnız bu bilgisayardan verilen sürümlü rıza ister.
# Görüntü ve ses yalnız bu bilgisayarda işlenir; yerel olmayan model adresi reddedilir.
# GORUS=false
# Yerel görsel model (OpenAI uyumlu uç, ör. Ollama / LM Studio):
# GORUS_MODEL_URL=http://127.0.0.1:11434/v1
# GORUS_MODEL=qwen2.5vl:3b
# Selam/mola cümlesini seslendir; 0 yalnız sesi kapatır:
# GORUS_SES=1
#
# Ses kimliği: kayıtlı sesin dışındaki sesli komutlar yok sayılır (güvenlik kilidi değildir).
# SES_KIMLIK=false
# CAM++ ONNX modelinin yolu (depoda yok; https://huggingface.co/csukuangfj/speaker-embedding-models):
# SES_KIMLIK_MODEL=
# Eşikler (benzerlik 0-1): komut · kısa ses · onay beklerken · onay beklerken kısa · "kısa" sayılan süre (sn)
# SES_KIMLIK_ESIK=0.50
# SES_KIMLIK_KISA_ESIK=0.40
# SES_KIMLIK_ONAY_ESIK=0.55
# SES_KIMLIK_ONAY_KISA_ESIK=0.42
# SES_KIMLIK_KISA_SN=1.0

# ── Harita gündemi ve dolgu sesi ────────────────────────────
# HARİTA › GÜNDEM aynı olayın başlıklarını tek satırda toplar (+N kaynak rozeti); 0 ham liste:
# GUNDEM_KUME=1
# Sesli konuşmada cevap gecikince bir kez kısa "Hmm." (varsayılan kapalı; HQ › Ses & TTS'ten de açılır):
# DOLGU_SESI=0
# İlk ses bu kadar milisaniyede gelmezse dolgu çalar (300-5000):
# DOLGU_GECIKME_MS=1200
# Seslendirilecek kısa metin:
# DOLGU_METNI=Hmm.

# ── Gemini canlı ses (⚡ düğmesi, deneysel, varsayılan kapalı) ──
# Sohbet hattından (STT → LLM → TTS) ayrı, tek Gemini Live oturumu. Açmak için ikisi birden:
# GEMINI_NATIVE_AUDIO=true
# GEMINI_API_KEY=
# Model ve ses adı (boş bırakılırsa bu varsayılanlar kullanılır):
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_VOICE=Aoede
